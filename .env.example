# Do not copy static secrets from examples. Generate .env with: node scripts/setup.mjs
MASTER_KEY=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
HOST=127.0.0.1
PORT=3100
BASE_URL=http://localhost:3100
DOMAIN=localhost
DATA_DIR=data
WORKER_ENABLED=true
SITE_NAME="AIR3 Social Studio"
ALLOW_REGISTRATION=false
# Keep email verification enabled unless the operator explicitly opts out.
REQUIRE_EMAIL_VERIFICATION=true
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=
LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
META_GRAPH_VERSION=
# Shared social apps for every AIR3 workspace. Users only see "Connect".
META_CLIENT_ID=
META_CLIENT_SECRET=
META_CONFIG_ID=
META_BUSINESS_ID=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
LINKEDIN_VERSION=202609
OUTBOUND_ORIGINS=
TRUST_PROXY_IPS=
FFMPEG_PATH=ffmpeg
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# Shared Facebook/Instagram app credentials can live only in the server environment above. Workspace access/refresh tokens remain encrypted in SQLite.
# The generated runtime env lives inside DATA_DIR; do not commit it.
